<%
  const T = summary.totals;
  const cards = summary.cards;
  const hot = cards.filter(c => c.votes > 0).sort((a, b) => b.votes - a.votes).slice(0, 3);
%>
<div class="aurora" aria-hidden="true"><i></i><i></i><i></i><span class="grain"></span></div>

<section class="l-hero">
  <p class="l-pill"><span class="l-dot"></span> En vivo · Ejercicio ciudadano de opinión 2027</p>
  <h1 class="l-title">
    <span class="l-line">Todo Veracruz.</span>
    <span class="l-line l-grad">Distrito por distrito.</span>
  </h1>
  <p class="l-sub">Explora los distritos federales y locales del estado, vota con tu cuenta de Google y mira en tiempo real quién va adelante en tu zona.</p>

  <div class="l-cta">
    <a href="#explorar" class="l-btn l-btn-primary">Encuentra tu distrito <span aria-hidden="true">→</span></a>
    <a href="#como" class="l-btn l-btn-ghost">Cómo funciona</a>
  </div>

  <div class="l-stats">
    <div class="l-stat"><b data-count="<%= T.districts %>" data-key="districts">0</b><span>Distritos</span></div>
    <div class="l-stat"><b data-count="<%= T.federal %>" data-key="federal">0</b><span>Federales</span></div>
    <div class="l-stat"><b data-count="<%= T.local %>" data-key="local">0</b><span>Locales</span></div>
    <div class="l-stat"><b data-count="<%= totalCandidates %>">0</b><span>Candidaturas</span></div>
    <div class="l-stat"><b data-count="<%= T.votes %>" data-key="votes">0</b><span>Votos de opinión</span></div>
  </div>

  <% if (hot.length) { %>
  <div class="l-float" aria-label="Distritos con más participación">
    <% hot.forEach(function(c, i){ %>
      <a class="l-glass l-glass-<%= i %>" href="/distrito/<%= c.id %>" style="--c:<%= c.leader ? c.leader.color : '#3EE6D0' %>">
        <small><%= c.type === 'federal' ? 'Federal' : 'Local' %> <%= c.number %> · <%= c.cabecera || c.name %></small>
        <strong><%= c.leader ? c.leader.name : 'Sin votos aún' %></strong>
        <span class="l-bar"><i style="width:<%= c.leader ? c.leader.pct : 0 %>%"></i></span>
        <em><%= c.leader ? c.leader.pct + '% · ' + c.leader.party : '' %></em>
      </a>
    <% }); %>
  </div>
  <% } %>
</section>


<div class="s-progress" aria-hidden="true"></div>

<% const PH = (typeof photos !== 'undefined' && photos) ? photos : []; %>
<section class="l-story" data-story <%- PH.length >= 2 ? 'data-mode="photo"' : '' %> aria-label="Veracruz en números">
  <div class="s-stage">
    <% if (PH.length >= 2) { %><div class="s-photos" aria-hidden="true"><% PH.forEach(function(src, i){ %><img class="s-photo" src="<%= src %>" alt="" decoding="async"<%- i > 1 ? ' loading="lazy"' : '' %>><% }); %></div><% } %>
    <canvas class="s-2d" aria-hidden="true"></canvas>
    <div class="s-big" aria-hidden="true"><b><%= T.districts %></b><span>distritos</span></div>
    <div class="s-cap"><p class="l-eyebrow">Un estado</p><h2>Cada rincón de Veracruz cuenta</h2><p><%= T.federal %> federales y <%= T.local %> locales, desde la Huasteca hasta los Tuxtlas.</p></div>
    <div class="s-cap"><% if (PH.length >= 2) { %><p class="l-eyebrow">Un distrito, una voz</p><h2>Desde la sierra hasta la costa</h2><p>Cada distrito tiene su propia historia y su propia gráfica.</p><% } else { %><p class="l-eyebrow">Un distrito, una torre</p><h2>Cada distrito se levanta con su gente</h2><p>La altura de cada torre crece con la participación.</p><% } %></div>
    <div class="s-cap"><p class="l-eyebrow">En vivo</p><h2><%= PH.length >= 2 ? "Tu voto mueve la gráfica" : "Tu voto la hace más alta" %></h2><p><%= T.votes > 0 ? 'Así va la participación ahora mismo.' : 'Aún no hay votos: sé el primero en votar.' %></p></div>
    <p class="s-hint" aria-hidden="true">Sigue bajando <span>↓</span></p>
  </div>
  <script type="application/json" id="story-data"><%- JSON.stringify(cards.map(function(c){ return { id: c.id, t: c.type, v: c.votes || 0, c: c.leader ? c.leader.color : null, n: c.cabecera || c.name }; })).replace(/</g, '\\u003c') %></script>
</section>

<% if (error === 'auth_required') { %>
  <p class="contact-alert contact-alert-err" style="max-width:520px;">Necesitas iniciar sesión con Google para votar o comentar. Usa el botón "Entrar con Google" arriba a la derecha.</p>
<% } %>

<section class="l-explore" id="explorar">
  <div class="l-head reveal">
    <p class="l-eyebrow">Explora el estado</p>
    <h2>Elige tu nivel y tu distrito</h2>
  </div>

  <div class="l-toolbar reveal">
    <div class="l-tabs" role="tablist" data-tabs>
      <button role="tab" class="is-on" data-type="all">Todos <em><%= T.districts %></em></button>
      <button role="tab" data-type="federal">Federales <em><%= T.federal %></em></button>
      <button role="tab" data-type="local">Locales <em><%= T.local %></em></button>
    </div>
    <label class="l-search">
      <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M11 4a7 7 0 105 12l4 4 1.4-1.4-4-4A7 7 0 0011 4zm0 2a5 5 0 110 10 5 5 0 010-10z" fill="currentColor"/></svg>
      <input type="search" placeholder="Busca tu municipio, cabecera o número…" data-search autocomplete="off">
    </label>
    <div class="l-chips" data-regions>
      <button class="is-on" data-region="all">Todo el estado</button>
      <% regions.forEach(function(r){ %><button data-region="<%= r %>"><%= r %></button><% }); %>
      <button data-flag="indigenous">Distritos indígenas</button>
    </div>
  </div>

  <div class="l-grid" data-grid>
    <% cards.forEach(function(c){ %>
      <a class="l-card reveal" href="/distrito/<%= c.id %>"
         data-type="<%= c.type %>" data-region="<%= c.region %>" data-ind="<%= c.indigenous ? 1 : 0 %>"
         data-id="<%= c.id %>"
         data-q="<%= (c.name + ' ' + c.cabecera + ' ' + c.number + ' ' + c.region).toLowerCase() %>"
         style="--c:<%= c.leader ? c.leader.color : '#3EE6D0' %>">
        <span class="l-card-top">
          <span class="tag tag-<%= c.type %>"><%= c.type === 'federal' ? 'Federal' : 'Local' %></span>
          <% if (c.indigenous) { %><span class="l-ind">Indígena</span><% } %>
          <span class="l-num"><%= String(c.number).padStart(2, '0') %></span>
        </span>
        <strong class="l-card-name"><%= c.cabecera || c.name %></strong>
        <small class="l-card-sub"><%= c.region %><% if (c.municipalities) { %> · <%= c.municipalities %> municipios<% } %></small>
        <span class="l-card-lead" data-lead>
          <% if (c.leader) { %>
            <span class="l-lead-name"><%= c.leader.name %></span>
            <span class="l-bar"><i style="width:<%= c.leader.pct %>%"></i></span>
            <em><%= c.leader.pct %>% · <%= c.votes %> votos</em>
          <% } else { %>
            <span class="l-lead-empty">Aún sin votos — sé el primero</span>
          <% } %>
        </span>
        <span class="l-arrow" aria-hidden="true">→</span>
      </a>
    <% }); %>
    <p class="l-empty" data-empty hidden>No encontramos distritos con esa búsqueda.</p>
  </div>
  <% if (T.districts === 0) { %>
    <p class="empty">Aún no hay distritos cargados. Corre <code>npm run seed:veracruz</code> o créalos desde /admin.</p>
  <% } %>
</section>

<section class="l-how" id="como">
  <div class="l-head reveal">
    <p class="l-eyebrow">Cómo funciona</p>
    <h2>Tres pasos, un voto por distrito</h2>
  </div>
  <div class="l-bento">
    <article class="l-tile reveal"><span>01</span><h3>Entra con Google</h3><p>Una cuenta, un voto por distrito. Sin formularios largos.</p></article>
    <article class="l-tile l-tile-wide reveal"><span>02</span><h3>Elige tu distrito federal y local</h3><p>Vota en ambos niveles: cada uno cuenta por separado y se muestra en su propia gráfica.</p></article>
    <article class="l-tile l-tile-wide reveal"><span>03</span><h3>Mira los resultados en vivo</h3><p>Gráfica, historial de votos y comentarios por candidatura, actualizados cada pocos segundos.</p></article>
    <article class="l-tile reveal"><span>✓</span><h3>Independiente</h3><p>Opinión ciudadana sin carácter oficial ni vínculo con autoridades electorales.</p></article>
  </div>
</section>

<section class="l-final reveal">
  <h2>¿Quieres una plataforma así para tu municipio o campaña?</h2>
  <p>Construimos consultas y paneles de resultados a la medida, con tu marca y dominio.</p>
  <a href="/contacto" class="l-btn l-btn-primary">Contáctanos <span aria-hidden="true">→</span></a>
</section>
