<section class="hero hero-lg">
  <p class="eyebrow">Boletín ciudadano · en curso</p>
  <h1>¿Quién va adelante en tu distrito?</h1>
  <p class="hero-sub">Consulta de opinión sobre las candidaturas locales y federales de la región de las Altas Montañas de Veracruz. Entra con tu cuenta, elige tu distrito y emite tu voto de opinión.</p>

  <div class="hero-actions">
    <a href="#distritos" class="btn btn-vote" style="width:auto;">Ver mi distrito</a>
    <a href="/contacto" class="btn btn-ghost" style="text-decoration:none;">Quiero una plataforma así</a>
  </div>

  <%
    // Grafica decorativa del hero: una sola linea (sin repetirse ni
    // hacer scroll) que se dibuja sola con stroke-dashoffset, y cada
    // punto destella justo cuando el trazo llega a el.
    //
    // Para lograr la sincronizacion exacta, calculamos aqui:
    //  1) la longitud total de la linea (suma de distancias entre
    //     puntos consecutivos), que es lo que usamos como
    //     stroke-dasharray/dashoffset para "dibujar" el trazo con CSS.
    //  2) la fraccion acumulada de esa longitud en la que cae cada
    //     punto, y con eso generamos un @keyframes distinto para cada
    //     punto (dot-flash-N) cuyo "destello" ocurre exactamente en el
    //     mismo porcentaje del ciclo en el que el trazo pasa por ahi.
    const CHART_POINTS = [[0,64],[70,46],[140,58],[210,28],[280,42],[350,18],[420,34],[490,10],[560,26]];
    const CHART_W = CHART_POINTS[CHART_POINTS.length - 1][0];
    const CHART_H = 90;
    const CYCLE = 7; // segundos que dura un ciclo completo (dibujar + pausa + desvanecer)
    const DRAW_END = 60;  // % del ciclo en que termina de dibujarse
    const HOLD_END = 86;  // % del ciclo hasta donde se queda visible
    const FADE_END = 97;  // % del ciclo en que termina de desvanecerse

    let totalLen = 0;
    const cum = [0];
    for (let i = 1; i < CHART_POINTS.length; i++) {
      const [x1, y1] = CHART_POINTS[i - 1];
      const [x2, y2] = CHART_POINTS[i];
      totalLen += Math.hypot(x2 - x1, y2 - y1);
      cum.push(totalLen);
    }

    const linePoints = CHART_POINTS.map(([x, y]) => `${x},${y}`).join(' ');

    const dotKeyframes = CHART_POINTS.map(([x, y], i) => {
      const arrivalPct = (cum[i] / totalLen) * DRAW_END;
      const flashPct = Math.min(arrivalPct + 2.5, DRAW_END);
      const p0 = Math.max(arrivalPct - 0.1, 0).toFixed(2);
      return `
        @keyframes dot-flash-${i} {
          0% { opacity: 0; transform: scale(0.3); }
          ${p0}% { opacity: 0; transform: scale(0.3); }
          ${arrivalPct.toFixed(2)}% { opacity: 1; transform: scale(2.2); filter: drop-shadow(0 0 6px var(--cyan)); }
          ${flashPct.toFixed(2)}% { opacity: 1; transform: scale(1); filter: none; }
          ${HOLD_END}% { opacity: 1; transform: scale(1); }
          ${FADE_END}% { opacity: 0; transform: scale(0.3); }
          100% { opacity: 0; transform: scale(0.3); }
        }
        .hero-chart-dot-${i} { animation: dot-flash-${i} ${CYCLE}s ease-in-out infinite; }
      `;
    }).join('\n');
  %>
  <style>
    @keyframes hero-chart-draw {
      0% { stroke-dashoffset: <%= totalLen.toFixed(2) %>; opacity: 1; }
      <%= DRAW_END %>% { stroke-dashoffset: 0; opacity: 1; }
      <%= HOLD_END %>% { stroke-dashoffset: 0; opacity: 1; }
      <%= FADE_END %>% { stroke-dashoffset: 0; opacity: 0; }
      100% { stroke-dashoffset: <%= totalLen.toFixed(2) %>; opacity: 0; }
    }
    .hero-chart-line-a {
      stroke-dasharray: <%= totalLen.toFixed(2) %>;
      animation: hero-chart-draw <%= CYCLE %>s ease-in-out infinite;
    }
    <%- dotKeyframes %>
  </style>
  <div class="hero-chart-decoration" aria-hidden="true">
    <div class="hero-chart-float">
      <svg class="hero-chart-svg" viewBox="0 0 <%= CHART_W %> <%= CHART_H %>" preserveAspectRatio="none">
        <polyline class="hero-chart-line hero-chart-line-a" points="<%= linePoints %>" />
        <% CHART_POINTS.forEach(function(p, i){ %>
          <circle class="hero-chart-dot hero-chart-dot-<%= i %>" cx="<%= p[0] %>" cy="<%= p[1] %>" r="3.5" />
        <% }); %>
      </svg>
    </div>
  </div>

  <div class="hero-stats">
    <div class="hero-stat">
      <span class="hero-stat-num"><%= totalDistricts %></span>
      <span class="hero-stat-label">Distritos activos</span>
    </div>
    <div class="hero-stat">
      <span class="hero-stat-num"><%= totalCandidates %></span>
      <span class="hero-stat-label">Candidaturas registradas</span>
    </div>
    <div class="hero-stat">
      <span class="hero-stat-num"><%= totalVotes %></span>
      <span class="hero-stat-label">Votos de opinión emitidos</span>
    </div>
  </div>
</section>

<% if (error === 'auth_required') { %>
  <p class="contact-alert contact-alert-err" style="max-width:520px;">
    Necesitas iniciar sesión con Google para poder votar o comentar. Usa el botón "Entrar con Google" arriba a la derecha.
  </p>
<% } %>

<section class="ledger" id="distritos">
  <div class="ledger-col">
    <h2 class="ledger-title"><span class="tag tag-federal">Federal</span> Distritos federales</h2>
    <% if (federal.length === 0) { %>
      <p class="empty">Aún no se han registrado distritos federales.</p>
    <% } %>
    <ol class="ledger-list">
      <% federal.forEach(function(d){ %>
        <li>
          <a href="/distrito/<%= d._id %>">
            <span class="ledger-num"><%= d.number ? String(d.number).padStart(2,'0') : '—' %></span>
            <span class="ledger-name"><%= d.name %></span>
            <span class="ledger-arrow">→</span>
          </a>
        </li>
      <% }); %>
    </ol>
  </div>

  <div class="ledger-col">
    <h2 class="ledger-title"><span class="tag tag-local">Local</span> Distritos locales</h2>
    <% if (local.length === 0) { %>
      <p class="empty">Aún no se han registrado distritos locales.</p>
    <% } %>
    <ol class="ledger-list">
      <% local.forEach(function(d){ %>
        <li>
          <a href="/distrito/<%= d._id %>">
            <span class="ledger-num"><%= d.number ? String(d.number).padStart(2,'0') : '—' %></span>
            <span class="ledger-name"><%= d.name %></span>
            <span class="ledger-arrow">→</span>
          </a>
        </li>
      <% }); %>
    </ol>
  </div>
</section>

<section class="landing-steps">
  <p class="landing-eyebrow">Cómo funciona</p>
  <div class="landing-steps-grid">
    <div class="landing-step">
      <span class="landing-step-num">1</span>
      <h3>Inicia sesión con Google</h3>
      <p>Solo necesitas tu cuenta de Google. Es gratis, toma segundos y nos ayuda a que cada persona vote una sola vez por distrito.</p>
    </div>
    <div class="landing-step">
      <span class="landing-step-num">2</span>
      <h3>Elige tu distrito</h3>
      <p>Busca tu distrito federal o local en la lista de arriba y revisa el perfil de cada candidatura, con su partido o coalición.</p>
    </div>
    <div class="landing-step">
      <span class="landing-step-num">3</span>
      <h3>Vota y opina</h3>
      <p>Emite tu voto de opinión, deja un comentario si quieres, y consulta los resultados en vivo, la gráfica y el historial de votos.</p>
    </div>
  </div>
</section>

<section class="contact-trust" style="border-top:1px solid var(--border); padding-top:32px;">
  <div class="contact-trust-item">
    <span class="contact-trust-num">100%</span>
    <span>Ejercicio ciudadano independiente, sin fines electorales oficiales</span>
  </div>
  <div class="contact-trust-item">
    <span class="contact-trust-num">1</span>
    <span>Voto de opinión por persona y distrito, verificado por cuenta de Google</span>
  </div>
  <div class="contact-trust-item">
    <span class="contact-trust-num">24/7</span>
    <span>Resultados públicos y actualizados en vivo</span>
  </div>
</section>

<section class="landing-section-head">
