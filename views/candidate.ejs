<p class="crumb"><a href="/">Inicio</a> / <a href="/distrito/<%= candidate.district._id %>"><%= candidate.district.name %></a></p>

<% if (error === 'auth_required') { %>
  <p class="contact-alert contact-alert-err" style="max-width:520px;">
    Necesitas iniciar sesión con Google para poder votar o comentar. Usa el botón "Entrar con Google" en la parte de arriba.
  </p>
<% } %>

<%
  function buildGlowSolid(colors) {
    const list = (colors && colors.length) ? colors : ['#3EE6D0'];
    const n = list.length;
    const arc = 360 / n;
    return list.map((c, i) => `${c} ${(i * arc).toFixed(1)}deg ${((i + 1) * arc).toFixed(1)}deg`).join(', ');
  }
%>
<section class="candidate-detail">
  <div class="party-glow" style="--glow-solid: <%= buildGlowSolid(candidate.partyColors) %>; --glow-primary: <%= (candidate.partyColors && candidate.partyColors[0]) || '#3EE6D0' %>;">
    <div class="candidate-photo-frame large">
      <img src="<%= candidate.photoUrl %>" alt="Foto de <%= candidate.name %>" onerror="this.src='/img/default-avatar.svg'">
      <span class="stamp" aria-hidden="true">Perfil</span>
    </div>
  </div>
  <div class="candidate-detail-info">
    <h1><%= candidate.name %></h1>
    <p class="party party-lg"><%= candidate.party %></p>
    <p class="bio"><%= candidate.bio || 'Este candidato aún no tiene biografía registrada.' %></p>

    <% if (myVote === candidate._id.toString()) { %>
      <p class="voted-flag">✓ Este es tu voto actual en el distrito</p>
    <% } else { %>
      <form action="/voto/<%= candidate._id %>" method="POST">
        <button type="submit" class="btn btn-vote"><%= myVote ? 'Cambiar mi voto a este candidato' : 'Votar por este candidato' %></button>
      </form>
    <% } %>
  </div>
</section>

<section class="comments-section">
  <h2>Comentarios ciudadanos</h2>

  <% if (user) { %>
    <form action="/comentario/<%= candidate._id %>" method="POST" class="comment-form">
      <textarea name="text" maxlength="500" rows="3" placeholder="Comparte tu opinión sobre esta candidatura…" required></textarea>
      <button type="submit" class="btn btn-vote">Publicar comentario</button>
    </form>
  <% } else { %>
    <p class="empty">Inicia sesión con Google para comentar.</p>
  <% } %>

  <ul class="comment-list">
    <% comments.forEach(function(c){ %>
      <li>
        <div class="comment-avatar">
          <% if (c.user && c.user.photo) { %><img src="<%= c.user.photo %>" alt=""><% } %>
        </div>
        <div>
          <p class="comment-author"><%= c.user ? c.user.name : 'Usuario' %> <span class="comment-date"><%= new Date(c.createdAt).toLocaleDateString('es-MX', { day: 'numeric', month: 'short', year: 'numeric' }) %></span></p>
          <p class="comment-text"><%= c.text %></p>
        </div>
      </li>
    <% }); %>
    <% if (comments.length === 0) { %>
      <p class="empty">Sé la primera persona en comentar.</p>
    <% } %>
  </ul>
</section>
